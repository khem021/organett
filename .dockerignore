# Secrets — never bake into the image
.env
.env.*
!.env.example

# Local data — databases, dumps and uploads must never ship in an image
database/*.sqlite*
storage/backups/
storage/app/private/*
storage/app/public/*
*.sql
*.sql.gz

# Docs and local tool state
*.docx
use_case_diagram.png
.claude/
.jamora/
.kilo/
.codex/
.cursor/

# Dependencies — installed inside the container
vendor/
node_modules/

# Build artefacts — generated inside the container
public/build/
public/hot

# Runtime storage — not needed at build time
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/

# Git history
.git/
.gitignore
.gitattributes

# Test suite
tests/
phpunit.xml
.phpunit.*

# IDE / OS clutter
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Previous platform config (not needed for Render)
nixpacks.toml
